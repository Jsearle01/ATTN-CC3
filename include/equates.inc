* ============================================================
* equates.inc — ATTN/11 -> 6309 production memory map
* ============================================================
* Dependencies: none
* Included by: everything
*
* Production layout for the training binary. Data lives at fixed
* absolute addresses; BW_SCRATCH at $6400 provides DP-addressable
* parameter blocks (DP=$64 in production). Stack grows down from
* $6800. See TRAIN_PLAN.md and Phase-6 commit for derivation.
* ============================================================

* -------- Model dimensions (match ATTN/11 exactly) --------
D               EQU     16              ; embedding dim
SEQ             EQU     8               ; sequence length
V               EQU     10              ; vocabulary size
DSEQ            EQU     D*SEQ           ; 128, activation row size
DD              EQU     D*D             ; 256, square weight size
DV              EQU     D*V             ; 160, embed/out proj size

* -------- Architecture scaling --------
ARCH_SHF        EQU     2               ; sqrt(D=16) = 4, log2(4) = 2

* -------- Learning rate shifts (WUPDT uses grad>>(shift-1)) --------
* Matches ATTN/11 UPDAT.MAC LR.EMB/LR.ATN/LR.OUT. Effective learning
* rate = 2^-shift in real-unit terms (see TRAIN_PLAN.md Q5).
LR_SHF_EMB      EQU     4               ; tok_emb, pos_emb: grad >> 3
LR_SHF_ATN      EQU     2               ; Wq, Wk, Wv:       grad >> 1 (raised from 1 to halve LR; stops step-300+ divergence)
LR_SHF_OUT      EQU     6               ; Wout:              grad >> 5

* -------- RAND PRNG constants (UPDAT.MAC 15-bit LCG) --------
RN_MUL          EQU     25173
RN_ADD          EQU     13849
RN_MASK         EQU     $7FFF           ; keep 15 bits
RN_INIT         EQU     887             ; initial seed

* -------- Training loop constants --------
NSTEP           EQU     350             ; full training run length
RPRT            EQU     50              ; print status every N steps
NTEST           EQU     10              ; samples in final test

* -------- Q-format sizes in bytes --------
Q8SZ            EQU     1
Q15SZ           EQU     2
Q16SZ           EQU     2

* ============================================================
* Memory map — CoCo3 low RAM
* ============================================================
VEC_BASE        EQU     $0000           ; 512B  interrupt vectors
SCREEN          EQU     $0400           ; 512B  hw-mapped text, 32x16
*               $0600-code_end          Code + EXPTBL + LOGTBL

* -------- Training state (48 B reserved) --------
TR_STATE        EQU     $1C00
TR_STEP         EQU     TR_STATE+0      ; 2B current step (0..NSTEP)
TR_HIT          EQU     TR_STATE+2      ; 2B correct predictions (since last REPORT)
TR_TOT          EQU     TR_STATE+4      ; 2B total predictions (since last REPORT)
TE_PRED         EQU     TR_STATE+6      ; 16B predicted-digit buffer for FINAL_TEST
IO_CURS         EQU     TR_STATE+22     ; 2B screen cursor (next write position)
TE_SOK          EQU     TR_STATE+24     ; 2B FINAL_TEST pass counter
*               TR_STATE+26..+47 reserved for future training-loop fields

* -------- Input / target tokens --------
TOKENS          EQU     $1C30           ; SEQ words = 16 B (input digits)
TARGET          EQU     $1C40           ; SEQ words = 16 B (reversed digits)

* ============================================================
* Q16 weight accumulators — split hi/lo (ATTN/11 layout)
* Each weight group has two separate arrays: all hi words contiguous,
* then all lo words contiguous. Q16 value = (hi << 16) | lo as
* signed 32-bit. Total 4864 bytes.
* ============================================================
W_TKEH          EQU     $1C50                   ; V*D = 160 w (320 B)
W_PSEH          EQU     W_TKEH+V*D*Q16SZ        ; SEQ*D = 128 w (256 B)
W_WQH           EQU     W_PSEH+SEQ*D*Q16SZ      ; D*D = 256 w (512 B)
W_WKH           EQU     W_WQH+DD*Q16SZ
W_WVH           EQU     W_WKH+DD*Q16SZ
W_WOTH          EQU     W_WVH+DD*Q16SZ          ; D*V = 160 w (320 B)
W_TKEL          EQU     W_WOTH+DV*Q16SZ         ; lo words start here
W_PSEL          EQU     W_TKEL+V*D*Q16SZ
W_WQL           EQU     W_PSEL+SEQ*D*Q16SZ
W_WKL           EQU     W_WQL+DD*Q16SZ
W_WVL           EQU     W_WKL+DD*Q16SZ
W_WOTL          EQU     W_WVL+DD*Q16SZ
W_END           EQU     W_WOTL+DV*Q16SZ         ; = $2D50

* ============================================================
* Q8 weight copies (regenerated by CVT16 each training step)
* Same shape as one side of Q16 split. Total 2432 B.
* ============================================================
W_TKEQ8         EQU     W_END                   ; = $2D50
W_PSEQ8         EQU     W_TKEQ8+V*D*Q15SZ
W_WQQ8          EQU     W_PSEQ8+SEQ*D*Q15SZ
W_WKQ8          EQU     W_WQQ8+DD*Q15SZ
W_WVQ8          EQU     W_WKQ8+DD*Q15SZ
W_WOTQ8         EQU     W_WVQ8+DD*Q15SZ
Q8_END          EQU     W_WOTQ8+DV*Q15SZ        ; = $36D0

* ============================================================
* Weight / embedding gradient accumulators (Q15). Zeroed by ZEROG
* once at startup; subsequent steps rely on WUPDT's per-element zero.
* Total 2432 B.
* ============================================================
G_TKE           EQU     Q8_END                  ; = $36D0  (d_tok_emb)
G_PSE           EQU     G_TKE+V*D*Q15SZ         ; (d_pos_emb)
G_WQ            EQU     G_PSE+SEQ*D*Q15SZ
G_WK            EQU     G_WQ+DD*Q15SZ
G_WV            EQU     G_WK+DD*Q15SZ
G_WOUT          EQU     G_WV+DD*Q15SZ
G_END           EQU     G_WOUT+DV*Q15SZ         ; = $4050

* ============================================================
* Forward cache — survives through BKWRD (backward reads all of it).
* ============================================================
* ATTN workspace = Q|K|V|S/A regions = 3*SEQ*D + SEQ*SEQ = 448 words = 896 B
AT_WORK_W       EQU     3*DSEQ+SEQ*SEQ          ; 448 words
FC_X            EQU     G_END                   ; = $4050  (SEQ*D Q8 embedding)
FC_WORK         EQU     FC_X+DSEQ*Q15SZ         ; ATTN workspace
FC_Y            EQU     FC_WORK+AT_WORK_W*Q15SZ ; ATTN output
FC_LOGITS       EQU     FC_Y+DSEQ*Q15SZ         ; SEQ*V Q15
FC_END          EQU     FC_LOGITS+SEQ*V*Q15SZ   ; = $4670

* ============================================================
* Backward workspace — transient, written fresh each BKWRD.
* DL (dLogits per-position temp) and DTMP (column-extract temp)
* live inside BW_SCRATCH; not allocated here.
* ============================================================
BW_DY           EQU     FC_END                  ; = $4670  (Q15 dY)
BW_DATT         EQU     BW_DY+DSEQ*Q15SZ        ; SEQ*SEQ Q15 (dA, in-place dSc)
BW_DQ           EQU     BW_DATT+SEQ*SEQ*Q15SZ
BW_DK           EQU     BW_DQ+DSEQ*Q15SZ
BW_DV           EQU     BW_DK+DSEQ*Q15SZ
BW_DX           EQU     BW_DV+DSEQ*Q15SZ
BW_DEND         EQU     BW_DX+DSEQ*Q15SZ        ; = $4BF0
*               $4BF0-$63FF gap (6160 B diagnostic headroom)

* ============================================================
* BW_SCRATCH — DP-addressable parameter blocks at $6400
* (DP=$64 in production). Internal offsets unchanged from prior
* phases; only the base address moved.
* ============================================================
BW_SCRATCH      EQU     $6400
BW_END          EQU     BW_SCRATCH+308          ; ends $6534
*               Stack: $6534..$67FF = 716 B
STACK_TOP       EQU     $6800

* -------- Fixed scratch at start of BW_SCRATCH --------
MULSCR          EQU     BW_SCRATCH              ; 4B STQ target
SOFTMAX_TMP     EQU     BW_SCRATCH+4            ; 32B softmax row buffer
VDOT_ACC        EQU     BW_SCRATCH+40           ; 4B 32-bit dot accumulator
VDOT_TMP        EQU     BW_SCRATCH+44           ; 2B carry-propagation temp
VSCL_ALPHA      EQU     BW_SCRATCH+46           ; 2B saved scalar for VSCL

* -------- MATOP parameter block (caller fills before JSR) --------
MP_MAT          EQU     BW_SCRATCH+48           ; 2B matrix base pointer
MP_VIN          EQU     BW_SCRATCH+50           ; 2B input vector / vx pointer
MP_OUT          EQU     BW_SCRATCH+52           ; 2B output vector / vy pointer
MP_ROW          EQU     BW_SCRATCH+54           ; 2B row count
MP_COL          EQU     BW_SCRATCH+56           ; 2B column count
MP_AHI          EQU     BW_SCRATCH+58           ; 2B accumulator high (internal)
MP_ALO          EQU     BW_SCRATCH+60           ; 2B accumulator low (internal)
MP_SCL          EQU     BW_SCRATCH+62           ; 2B scalar temp (internal)

* -------- SFTMX parameter block --------
SF_VEC          EQU     BW_SCRATCH+64           ; 2B softmax input vector pointer
SF_LEN          EQU     BW_SCRATCH+66           ; 2B softmax length
SF_MAX          EQU     BW_SCRATCH+68           ; 2B softmax max value (internal)
SF_SUM          EQU     BW_SCRATCH+70           ; 2B softmax exp sum
SF_OUT          EQU     BW_SCRATCH+72           ; 2B softmax output pointer

* -------- VCPY/VCLR parameter block --------
V_SRC           EQU     BW_SCRATCH+74           ; 2B source pointer (VCPY)
V_DST           EQU     BW_SCRATCH+76           ; 2B destination pointer
V_LEN           EQU     BW_SCRATCH+78           ; 2B word count

* -------- VSADD parameter block (aliases V_* for src/dst/len) --------
VS_SRC          EQU     V_SRC
VS_DST          EQU     V_DST
VS_LEN          EQU     V_LEN
VS_SCL          EQU     BW_SCRATCH+80           ; 2B Q8 scalar (dedicated)
*               BW_SCRATCH+82 through +83 reserved for future use

* -------- EMBED parameter block --------
EM_TOK          EQU     BW_SCRATCH+84           ; 2B token index array ptr
EM_TKE          EQU     BW_SCRATCH+86           ; 2B token embedding table ptr
EM_PSE          EQU     BW_SCRATCH+88           ; 2B position embedding table ptr
EM_OUT          EQU     BW_SCRATCH+90           ; 2B output buffer ptr
EM_SEQ          EQU     BW_SCRATCH+92           ; 2B sequence length
EM_DIM          EQU     BW_SCRATCH+94           ; 2B embedding dimension
EM_RBS          EQU     BW_SCRATCH+96           ; 2B row byte size (internal)
EM_TPTR         EQU     BW_SCRATCH+98           ; 2B advancing token ptr (internal)

* -------- PROJ parameter block --------
PR_Y            EQU     BW_SCRATCH+100          ; 2B input Y ptr [SEQ][DIM]
PR_WOUT         EQU     BW_SCRATCH+102          ; 2B output projection weights
PR_LOG          EQU     BW_SCRATCH+104          ; 2B output logits buffer
PR_SEQ          EQU     BW_SCRATCH+106          ; 2B sequence length
PR_DIM          EQU     BW_SCRATCH+108          ; 2B d_model
PR_VOC          EQU     BW_SCRATCH+110          ; 2B vocab size
PR_YST          EQU     BW_SCRATCH+112          ; 2B Y row stride (internal)
PR_LST          EQU     BW_SCRATCH+114          ; 2B LOG row stride (internal)

* -------- ATTN parameter block --------
AT_XIN          EQU     BW_SCRATCH+116          ; 2B input X ptr [SEQ][DIM]
AT_WQ           EQU     BW_SCRATCH+118          ; 2B Wq [DIM][DIM]
AT_WK           EQU     BW_SCRATCH+120          ; 2B Wk
AT_WV           EQU     BW_SCRATCH+122          ; 2B Wv
AT_YOT          EQU     BW_SCRATCH+124          ; 2B output Y ptr
AT_WRK          EQU     BW_SCRATCH+126          ; 2B workspace base (896B)
AT_SEQ          EQU     BW_SCRATCH+128          ; 2B sequence length
AT_DIM          EQU     BW_SCRATCH+130          ; 2B embedding dimension
AT_SHF          EQU     BW_SCRATCH+132          ; 2B sqrt(d) right-shift count
AT_RSZ          EQU     BW_SCRATCH+134          ; 2B row stride (internal)
AT_SSZ          EQU     BW_SCRATCH+136          ; 2B seq stride (internal)
AT_QQ           EQU     BW_SCRATCH+138          ; 2B Q region base (internal)
AT_KK           EQU     BW_SCRATCH+140          ; 2B K region base
AT_VV           EQU     BW_SCRATCH+142          ; 2B V region base
AT_SS           EQU     BW_SCRATCH+144          ; 2B S/A region base

* -------- ATTN Step 4+ cursors (aliased with AT_BPR helpers) --------
AT_QI           EQU     BW_SCRATCH+146          ; 2B Q row cursor
AT_KJ           EQU     BW_SCRATCH+148          ; 2B K row cursor
AT_SI           EQU     BW_SCRATCH+150          ; 2B S/A row cursor
AT_IC           EQU     BW_SCRATCH+152          ; 2B inner counter
AT_BW           EQU     AT_QI                   ; alias: BPR weight ptr (Steps 1-3)
AT_BI           EQU     AT_KJ                   ; alias: BPR input ptr
AT_BO           EQU     AT_SI                   ; alias: BPR output ptr
AT_BC           EQU     AT_IC                   ; alias: BPR counter
AT_YI           EQU     BW_SCRATCH+154          ; 2B Y output row cursor (Step 6)
AT_OC           EQU     BW_SCRATCH+156          ; 2B outer SEQ counter (Steps 4-6)

* -------- CLOSS parameter block --------
CL_LOG          EQU     BW_SCRATCH+158          ; 2B logits ptr
CL_TGT          EQU     BW_SCRATCH+160          ; 2B target tokens ptr
CL_SEQ          EQU     BW_SCRATCH+162          ; 2B sequence length
CL_VOC          EQU     BW_SCRATCH+164          ; 2B vocab size
CL_AHI          EQU     BW_SCRATCH+166          ; 2B 32-bit loss accumulator high
CL_ALO          EQU     BW_SCRATCH+168          ; 2B 32-bit loss accumulator low
CL_VST          EQU     BW_SCRATCH+170          ; 2B VOC stride (internal)
CL_TMP          EQU     BW_SCRATCH+172          ; 20B softmax temp (VOC=10 max)

* -------- BKWRD parameter block (aliases CL_TMP for BK_DL) --------
* BK_DL shares storage with CL_TMP — CLOSS and BKWRD never run concurrently.
BK_DL           EQU     CL_TMP                  ; 20B dLogits temp
BK_LOG          EQU     BW_SCRATCH+192          ; 2B logits [SEQ][VOC] (fwd cache)
BK_TGT          EQU     BW_SCRATCH+194          ; 2B target tokens [SEQ]
BK_YY           EQU     BW_SCRATCH+196          ; 2B Y [SEQ][DIM] (fwd cache)
BK_WOUT         EQU     BW_SCRATCH+198          ; 2B Wout [DIM][VOC] (Q8)
BK_XX           EQU     BW_SCRATCH+200          ; 2B X [SEQ][DIM] (fwd cache)
BK_WQ           EQU     BW_SCRATCH+202          ; 2B Wq [DIM][DIM] (Q8)
BK_WK           EQU     BW_SCRATCH+204          ; 2B Wk
BK_WV           EQU     BW_SCRATCH+206          ; 2B Wv
BK_WRK          EQU     BW_SCRATCH+208          ; 2B ATTN workspace base
BK_DWOUT        EQU     BW_SCRATCH+210          ; 2B dWout output (Q15)
BK_DY           EQU     BW_SCRATCH+212          ; 2B dY output (Q15)
BK_SEQ          EQU     BW_SCRATCH+214          ; 2B sequence length
BK_DIM          EQU     BW_SCRATCH+216          ; 2B embedding dimension
BK_VOC          EQU     BW_SCRATCH+218          ; 2B vocab size
BK_SHF          EQU     BW_SCRATCH+220          ; 2B sqrt(d) shift (Step 3)

* -------- BKWRD internal scratch (strides + cursors) --------
BK_RSZ          EQU     BW_SCRATCH+222          ; 2B row stride = DIM*2
BK_VST          EQU     BW_SCRATCH+224          ; 2B vocab stride = VOC*2
BK_SST          EQU     BW_SCRATCH+226          ; 2B seq stride = SEQ*2
BK_YI           EQU     BW_SCRATCH+228          ; 2B Y row cursor (Step 1)
BK_DYI          EQU     BW_SCRATCH+230          ; 2B dY row cursor (Steps 1-2)

* -------- BKWRD Steps 2-3 (workspace sub-region ptrs + cursors) --------
BK_QP           EQU     BW_SCRATCH+232          ; 2B Q workspace base
BK_KP           EQU     BW_SCRATCH+234          ; 2B K workspace base
BK_VP           EQU     BW_SCRATCH+236          ; 2B V workspace base (Step 2)
BK_AP           EQU     BW_SCRATCH+238          ; 2B A workspace base (Steps 2-3)
BK_VJ           EQU     BW_SCRATCH+240          ; 2B V[j] inner cursor (Step 2)
BK_DVJ          EQU     BW_SCRATCH+242          ; 2B dV[j] inner cursor (Step 2)
BK_AI           EQU     BW_SCRATCH+244          ; 2B A row cursor (Steps 2-3)
BK_DAI          EQU     BW_SCRATCH+246          ; 2B dA row cursor (Steps 2-3)
BK_DAD          EQU     BW_SCRATCH+248          ; 2B dot_ad temp (Step 3)

* -------- BKWRD Step 4 column-extract temp --------
BK_DTMP         EQU     BW_SCRATCH+250          ; 32B column extract temp (Step 4)

* -------- BKWRD Steps 4-6 parameter/scratch fields --------
BK_TOKS         EQU     BW_SCRATCH+282          ; 2B input tokens ptr (Step 6)
BK_DWQ          EQU     BW_SCRATCH+284          ; 2B dWq output accumulator (Step 5)
BK_DWK          EQU     BW_SCRATCH+286          ; 2B dWk
BK_DWV          EQU     BW_SCRATCH+288          ; 2B dWv
BK_DTKE         EQU     BW_SCRATCH+290          ; 2B d_tok_emb output (Step 6)
BK_DPSE         EQU     BW_SCRATCH+292          ; 2B d_pos_emb output (Step 6)
BK_OFF          EQU     BW_SCRATCH+294          ; 2B position offset temp / d_pos cursor

* -------- UPDAT parameter block (shared by WUPDT/CVT16/INITW _ONE) --------
UP_WHI          EQU     BW_SCRATCH+296          ; 2B weight hi array ptr
UP_WLO          EQU     BW_SCRATCH+298          ; 2B weight lo array ptr
UP_PTR          EQU     BW_SCRATCH+300          ; 2B aux ptr (grad | Q8 dest)
UP_CNT          EQU     BW_SCRATCH+302          ; 2B element count
UP_SHF          EQU     BW_SCRATCH+304          ; 2B lr_shift (WUPDT only)

* -------- RAND PRNG state --------
RN_SED          EQU     BW_SCRATCH+306          ; 2B LCG seed (init to RN_INIT)

* -------- Hardware --------
GIME_INIT0      EQU     $FF90
GIME_VMODE      EQU     $FF98
GIME_VRES       EQU     $FF99
PIA1_DDRA       EQU     $FF00
